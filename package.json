{
  "name": "volpexar.com",
  "private": true,
  "description": "The Volpexar website: a Next.js frontend with content managed in Sanity",
  "homepage": "https://github.com/volpexar/volpexar.com#readme",
  "bugs": {
    "url": "https://github.com/volpexar/volpexar.com/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volpexar/volpexar.com.git"
  },
  "workspaces": [
    "studio",
    "frontend"
  ],
  "scripts": {
    "dev": "npx run-p --print-label dev:next dev:studio",
    "dev:next": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "dev:prod": "npx run-p --print-label dev:*:prod",
    "dev:next:prod": "cross-env NEXT_PUBLIC_SANITY_DATASET=production npm run dev:next",
    "dev:studio:prod": "cross-env SANITY_STUDIO_DATASET=production npm run dev:studio",
    "format": "prettier --cache --write .",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspaces",
    "prepare": "node .husky/install.mjs"
  },
  "prettier": "@sanity/prettier-config",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@sanity/prettier-config": "^3.0.0",
    "cross-env": "10.1.0",
    "husky": "^9.1.7",
    "npm-run-all2": "^5.0.2",
    "prettier": "^3.8.1"
  }
}
