# The Studio reads three env files, and which ones apply depends on the command.
# `sanity dev` loads .env then .env.development; `sanity build` and `sanity deploy`
# load .env then .env.production. Create all three: a missing mode file means the
# Studio starts against whichever dataset happens to be left over.
#
# All three are gitignored. Copy this file to create each one.

# ---------------------------------------------------------------------------
# .env — shared by every mode
# ---------------------------------------------------------------------------
SANITY_STUDIO_PROJECT_ID="<your project ID>" # Required - The ID of your Sanity project
SANITY_STUDIO_STUDIO_HOST="" #Optional - Subdomain for the hosted Studio

# ---------------------------------------------------------------------------
# .env.development — `sanity dev` only
# ---------------------------------------------------------------------------
# Preview stays on localhost because Presentation previews the frontend you are
# running. Keep it there: to work against live content use `npm run dev:prod`, which
# moves the Studio and the frontend together. Moving only one breaks Presentation.
#
# SANITY_STUDIO_DATASET="development"
# SANITY_STUDIO_PREVIEW_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# .env.production — `sanity build` and `sanity deploy` only
# ---------------------------------------------------------------------------
# These are the values the hosted Studio is built with, so this dataset is the one
# editors change on the live site.
#
# SANITY_STUDIO_DATASET="production"
# SANITY_STUDIO_PREVIEW_URL="https://volpexar.com"
